    PROC SET_X_CHAN_LnR(
    STRING WHAT_SIDE,
    INOUT ROBTARGET The_Weld,
    INOUT ROBTARGET Chan_Found,
    INOUT ROBTARGET ChanLam_FOUND)
!!notes 1/14/19 added Top_Of_Chan_Y for when its less than 3 cross bars
!    VAR num Top_Of_Chan_Y :=0;
    
!        IF HORIZ_Y3 > 0 and HORIZ_Y3 = FP_Height THEN 
!            Top_Of_Chan_Y := HORIZ_Y3;
!        ELSEIF HORIZ_Y3 = 0 AND HORIZ_Y2 = FP_Height THEN
!            Top_Of_Chan_Y := HORIZ_Y2;
!        ELSEIF HORIZ_Y3 = 0 AND HORIZ_Y2 = 0 and HORIZ_Y1 = FP_Height THEN
!            Top_Of_Chan_Y := HORIZ_Y1;
!        ELSEIF HORIZ_Y3 > 0 AND HORIZ_Y2 > 0 and HORIZ_Y1 > 0 AND HORIZ_Y4 = FP_Height THEN
!            Top_Of_Chan_Y := HORIZ_Y4;
!            ENDIF      
    IF WHAT_SIDE = "LL" THEN
  
        IF The_Weld.trans.Y < Lam_OverLap THEN
               The_Weld.trans.X := ChanLam_FOUND.trans.X + Minor_Nozzle_Radius - (FP_StickOut * 1.15);
      
        ELSEIF The_Weld.trans.Y >= Lam_OverLap THEN
               The_Weld.trans.X := Chan_FOUND.trans.X + Minor_Nozzle_Radius - (FP_StickOut * 1.15 );
        ENDIF
    
    ELSEIF WHAT_SIDE = "LR" THEN           

            IF The_Weld.trans.Y < (Top_Of_Chan_Y - CHANNEL_LENGTH)  THEN
                The_Weld.trans.X := ChanLam_FOUND.trans.X + Minor_Nozzle_Radius + BAR_THICKNESS + FP_StickOut ;

            ELSEIF The_Weld.trans.Y >= (Top_Of_Chan_Y - CHANNEL_LENGTH) AND The_Weld.trans.Y <= Top_Of_Chan_Y  THEN
                The_Weld.trans.X := Chan_FOUND.trans.X + Minor_Nozzle_Radius + CHANNEL_WIDTH + FP_StickOut ;
            
            ELSEIF The_Weld.trans.Y > Top_Of_Chan_Y THEN  
                The_Weld.trans.X := Chan_FOUND.trans.X + Minor_Nozzle_Radius + BAR_THICKNESS + FP_StickOut ;                
                
            ENDIF

    ELSEIF WHAT_SIDE = "RR" THEN     

        IF The_Weld.trans.Y < Lam_OverLap THEN
               The_Weld.trans.X := ChanLam_FOUND.trans.X - Minor_Nozzle_Radius + (FP_StickOut * 1.15) ;
      
        ELSEIF The_Weld.trans.Y > Lam_OverLap   THEN
               The_Weld.trans.X := Chan_FOUND.trans.X - Minor_Nozzle_Radius + (FP_StickOut * 1.15) ;
        
        ENDIF
        
    ELSEIF WHAT_SIDE = "RL" THEN    
    
            IF The_Weld.trans.Y < (Top_Of_Chan_Y - CHANNEL_LENGTH) THEN
                The_Weld.trans.X := ChanLam_FOUND.trans.X - Minor_Nozzle_Radius - BAR_THICKNESS - FP_StickOut;

            ELSEIF The_Weld.trans.Y >= (Top_Of_Chan_Y - CHANNEL_LENGTH) AND The_Weld.trans.Y < Top_Of_Chan_Y THEN
                The_Weld.trans.X := Chan_FOUND.trans.X - Minor_Nozzle_Radius - CHANNEL_WIDTH - FP_StickOut;
           
           ELSEIF The_Weld.trans.Y > Top_Of_Chan_Y THEN 
                The_Weld.trans.X := Chan_FOUND.trans.X - Minor_Nozzle_Radius - BAR_THICKNESS - FP_StickOut;
            ENDIF
        
    ENDIF 
        WAITTIME\INPOS,.1;   
            ENDPROC







