PROC ALL_Chan_Plan(NUM WELD_LENGTH)

	
IF LOAD_PUSH = TRUE  THEN
    OAL_Stitch :=  FP_Height - FP_Thickness - (2*FP_StickOut);
ELSEIF LOAD_PUSH = FALSE THEN
    OAL_Stitch := FP_Height - ( HORIZ_Y2 + bar_thickness + (2*FP_StickOut));
ENDIF

How_Many := ROUND( OAL_Stitch / WELD_LENGTH );
How_Long := OAL_Stitch / How_Many;
FROM_HERE := FP_Height - OAL_Stitch - fp_stickout;
TPErase;
TPWrite" How_Many :="\Num:=How_Many;
TPWrite" How_Long := "\Num:=How_Long;

    FOR k FROM 1 TO How_Many
    STEP + 1 DO

    IF K = 1 THEN 
     LL_CHAN_WELDS{ k , 1}.trans.Y :=  FROM_HERE + ( k * How_Long ) ;
     LL_CHAN_WELDS{ k , 1}.EXTAX := LL_CHAN_GOINGdown.extax;
     LL_CHAN_WELDS{ k , 1}.ROT := LL_CHAN_GOINGdown.ROT;
     LL_CHAN_WELDS{ k , 1}.RobConf := LL_CHAN_GOINGdown.RobConf;
     
