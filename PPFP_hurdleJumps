        ELSEIF RR_CHAN_WELDS{s,r}.trans.Y > (HORIZ_Y2 + BAR_THICKNESS + CHANNEL_LamBar_Length) THEN
            RR_CHAN_WELDS{s,r}.TRANS.X :=RX2 - BAR_THICKNESS + FP_StickOut;
        ENDIF         
      
      ENDIF  
        
        
        
        IF  LR_CHAN_WELDS{s,r}.trans.Y < (Top_Of_Chan_Y - CHANNEL_LENGTH) OR LR_CHAN_WELDS{s,r}.trans.Y > Top_Of_Chan_Y  THEN
            LR_CHAN_WELDS{s,r}.TRANS.X := LX2 + BAR_THICKNESS + FP_StickOut;
        ELSEIF LR_CHAN_WELDS{s,r}.trans.Y > (Top_Of_Chan_Y - CHANNEL_LENGTH) AND (LR_CHAN_WELDS{s,r}.trans.Y <= Top_Of_Chan_Y) THEN
            LR_CHAN_WELDS{s,r}.TRANS.X := LX2 + BAR_THICKNESS + CHANNEL_WIDTH + FP_StickOut;
        ENDIF
        

       
        IF RL_CHAN_WELDS{s,r}.trans.Y < (Top_Of_Chan_Y - CHANNEL_LENGTH) OR RL_CHAN_WELDS{s,r}.TRANS.Y  > Top_Of_Chan_Y THEN
            RL_CHAN_WELDS{s,r}.TRANS.X := RX2 - BAR_THICKNESS - FP_StickOut;
        ELSEIF RL_CHAN_WELDS{s,r}.trans.Y > Top_Of_Chan_Y - CHANNEL_LENGTH AND RL_CHAN_WELDS{s,r}.trans.Y <= Top_Of_Chan_Y  THEN
            RL_CHAN_WELDS{s,r}.TRANS.X := RX2 - BAR_THICKNESS - CHANNEL_WIDTH - FP_StickOut;
        ENDIF

    ENDFOR
    ENDFOR

    DUNNED:   
    ENDPROC
    


    PROC LLnRR_CHAN_PLAN (
    INOUT NUM Uh_Hurdle)
!  NOTES
!  R25  ADDED LEFT_Hurdle & RIGHT_Hurdle  4/9/19
!  ADDED IF LESS THAN TIGHTBOX SKIP THE WELD
!  The outsides of the channels use this function, 
!  you can select "HORIZ_Y1",  "HORIZ_Y2",  HORIZ_Y3". 
!  Hopefully it will hop over the fences?

    VAR NUM RIGHT_Hurdle;
    VAR NUM Left_Hurdle;
    VAR NUM Hold_This;
    


IF Uh_Hurdle = 0 OR (Uh_Hurdle = FP_Height) THEN GOTO NOT_TODAY;
ENDIF

    ! THIS IS TO OFFSET THE HURDLES BY THE MISLOCATION
    ! OF THE HORIZONTAL BARS DURING TACK-UP
    
    !  ADD THE BAR DISPLACEMENT TO THE HURDLE
 IF Uh_Hurdle = HORIZ_Y1 THEN
        Left_Hurdle := HORIZ_Y1 + SR_LX2_Y1.TRANS.Y;
        Right_Hurdle := HORIZ_Y1 + SR_RX2_Y1.TRANS.Y;
 ELSEIF Uh_Hurdle = HORIZ_Y2 THEN
        Left_Hurdle := HORIZ_Y2 + SR_LX2_Y2.TRANS.Y;
        Right_Hurdle := HORIZ_Y2 + SR_RX2_Y2.TRANS.Y;
 ELSEIF Uh_Hurdle = HORIZ_Y3 THEN
        Left_Hurdle := HORIZ_Y3 + SR_LX2_Y3.TRANS.Y;
        Right_Hurdle := HORIZ_Y3 + SR_RX2_Y3.TRANS.Y;
 ELSEIF Uh_Hurdle = HORIZ_Y4 THEN
        Left_Hurdle := HORIZ_Y4 + SR_LX2_Y4.TRANS.Y;
        Right_Hurdle := HORIZ_Y4 + SR_RX2_Y4.TRANS.Y;
 ENDIF
 
 
 
FOR p FROM 2 TO How_Many
STEP +1 DO
    
!  SCENERIO : IS THE WELD OVERLAPPING THE HURDLE?
 IF ((LL_CHAN_WELDS{p,1}.trans.Y < (Left_Hurdle - NOZZLE_RADIUS)) AND (LL_CHAN_WELDS{p,3}.trans.Y >= (Left_Hurdle - NOZZLE_RADIUS))) OR   (((LL_CHAN_WELDS{p,1}.trans.Y <= (Left_Hurdle +  BAR_THICKNESS + NOZZLE_RADIUS)) AND (LL_CHAN_WELDS{p,3}.trans.Y > (Left_Hurdle + BAR_THICKNESS + NOZZLE_RADIUS)))) THEN
 
    !THEN Which half is bigger
        IF (LL_CHAN_WELDS{p,3}.Trans.Y - (Left_Hurdle + BAR_THICKNESS)) > ( (Left_Hurdle + BAR_THICKNESS) - LL_CHAN_WELDS{p,1}.Trans.Y) THEN
           
            ! THE TOP IS BIGGER, 
                LL_CHAN_WELDS{p,1}.Trans.Y := Left_Hurdle + HOW_LONG; !LL_CHAN_WELDS{p,3}.Trans.Y + BAR_THICKNESS ;
                LL_CHAN_WELDS{p,1}.extax := LL_CHAN_GOINGdown.extax;
                LL_CHAN_WELDS{p,1}.ROT := LL_CHAN_GOINGdown.ROT;
                LL_CHAN_WELDS{p,1}.RobConf := LL_CHAN_GOINGdown.RobConf;
                
                LL_CHAN_WELDS{p,2}.Trans.Y := (Left_Hurdle + BAR_THICKNESS + NOZZLE_RADIUS);
                LL_CHAN_WELDS{p,2}.extax := LL_CHAN_GOINGdown.extax;
                LL_CHAN_WELDS{p,2}.ROT := LL_CHAN_GOINGdown.ROT;
                LL_CHAN_WELDS{p,2}.RobConf := LL_CHAN_GOINGdown.RobConf;
                
                LL_CHAN_WELDS{p,3}.Trans.Y := (Left_Hurdle + BAR_THICKNESS + FP_StickOut);
                LL_CHAN_WELDS{p,3}.extax := LL_CHAN_GOINGdownCORNER.extax;
                LL_CHAN_WELDS{p,3}.ROT := LL_CHAN_GOINGdownCORNER.ROT;
                LL_CHAN_WELDS{p,3}.RobConf := LL_CHAN_GOINGdownCORNER.RobConf;
                
                !TPWrite" LL_CHAN_WELDS one is over the Hurdle.."\Num:=p;  
                LL_CHAN_NOTES{ p , 1}:="CORNER";
                LL_CHAN_NOTES{ p , 2}:="BUDGED";
                
        ELSEIF (LL_CHAN_WELDS{p,3}.Trans.Y - (Left_Hurdle + BAR_THICKNESS)) <= ((Left_Hurdle + BAR_THICKNESS ) - LL_CHAN_WELDS{p,1}.Trans.Y) THEN     
           
            ! THE BOTTOM IS BIGGGER
                LL_CHAN_WELDS{p,1}.Trans.Y :=  Left_Hurdle - How_Long  ;!LL_CHAN_WELDS{p,1}.Trans.Y - BAR_THICKNESS;
                LL_CHAN_WELDS{p,2}.Trans.Y := (Left_Hurdle - NOZZLE_RADIUS);
               
                LL_CHAN_WELDS{p,3}.Trans.Y := Left_Hurdle - FP_StickOut;             
                LL_CHAN_WELDS{p,3}.extax := LL_CHAN_GOINGUPCORNER.extax;
                LL_CHAN_WELDS{p,3}.ROT := LL_CHAN_GOINGUPCORNER.ROT;
                LL_CHAN_WELDS{p,3}.RobConf := LL_CHAN_GOINGUPCORNER.RobConf;
                !TPWrite" LL_CHAN_WELD is short of the Hurdle.."\Num:=p;  
                LL_CHAN_NOTES{ p , 1}:="CORNER";
                LL_CHAN_NOTES{ p , 2}:="FLIPPED";
   
         ENDIF
    ENDIF
 

         
!  SCENERIO : IS THE WELD OVERLAPPING THE HURDLE?
IF ((RR_CHAN_WELDS{p,1}.trans.Y < (RIGHT_Hurdle - NOZZLE_RADIUS)) AND (RR_CHAN_WELDS{p,3}.trans.Y >= (RIGHT_Hurdle - NOZZLE_RADIUS))) OR   (((RR_CHAN_WELDS{p,1}.trans.Y <= (RIGHT_Hurdle +  BAR_THICKNESS + NOZZLE_RADIUS)) AND (RR_CHAN_WELDS{p,3}.trans.Y > (RIGHT_Hurdle + BAR_THICKNESS + NOZZLE_RADIUS)))) THEN
 
    !THEN WHICH HALF IS BIGGER
        IF (RR_CHAN_WELDS{p,3}.Trans.Y - (RIGHT_Hurdle + BAR_THICKNESS)) > ( (RIGHT_Hurdle + BAR_THICKNESS) - RR_CHAN_WELDS{p,1}.Trans.Y) THEN
                  
                RR_CHAN_WELDS{p,1}.Trans.Y := RIGHT_Hurdle + How_Long;  !RR_CHAN_WELDS{p,3}.Trans.Y + BAR_THICKNESS;
                RR_CHAN_WELDS{p,1}.extax := RR_CHAN_GOINGdown.extax;
                RR_CHAN_WELDS{p,1}.ROT := RR_CHAN_GOINGdown.ROT;
                RR_CHAN_WELDS{p,1}.RobConf := RR_CHAN_GOINGdown.RobConf;
                
                RR_CHAN_WELDS{p,2}.Trans.Y := (RIGHT_Hurdle + BAR_THICKNESS + NOZZLE_RADIUS);
                RR_CHAN_WELDS{p,2}.extax := RR_CHAN_GOINGdown.extax;
                RR_CHAN_WELDS{p,2}.ROT := RR_CHAN_GOINGdown.ROT;
                RR_CHAN_WELDS{p,2}.RobConf := RR_CHAN_GOINGdown.RobConf;
                
                RR_CHAN_WELDS{p,3}.Trans.Y := (RIGHT_Hurdle + BAR_THICKNESS + FP_StickOut);
                RR_CHAN_WELDS{p,3}.extax := RR_CHAN_BOTTOMcorner.extax;
                RR_CHAN_WELDS{p,3}.ROT := RR_CHAN_BOTTOMcorner.ROT;
                RR_CHAN_WELDS{p,3}.RobConf := RR_CHAN_BOTTOMcorner.RobConf;
                     
                !TPWrite" RR_CHAN_WELDS one is over the Hurdle.."\Num:=p;  
                RR_CHAN_NOTES{ p , 1}:="CORNER";                 
                RR_CHAN_NOTES{ p , 2}:="BUDGED";                 
        ELSEIF (RR_CHAN_WELDS{p,3}.Trans.Y - (RIGHT_Hurdle + BAR_THICKNESS)) <= ((RIGHT_Hurdle + BAR_THICKNESS ) - RR_CHAN_WELDS{p,1}.Trans.Y) THEN     
             
            ! THE BOTTOM IS BIGGER
             
                RR_CHAN_WELDS{p,1}.Trans.Y := RIGHT_Hurdle - How_Long; ! RR_CHAN_WELDS{p,1}.Trans.Y - BAR_THICKNESS;
                RR_CHAN_WELDS{p,2}.Trans.Y := (RIGHT_Hurdle - NOZZLE_RADIUS);
                
                RR_CHAN_WELDS{p,3}.Trans.Y := RIGHT_Hurdle - FP_StickOut;             
                RR_CHAN_WELDS{p,3}.extax := RR_CHAN_TOPcorner.extax;
                RR_CHAN_WELDS{p,3}.ROT := RR_CHAN_TOPcorner.ROT;
                RR_CHAN_WELDS{p,3}.RobConf := RR_CHAN_TOPcorner.RobConf;
            
                RR_CHAN_NOTES{ p , 1}:="CORNER";
                RR_CHAN_NOTES{ p , 2}:="FLIPPED";
                !TPWrite" RR_CHAN_WELD is short of the Hurdle.."\Num:=p;                  
        ENDIF
ENDIF   
         
ENDFOR


         
         
         
 
  ! SCENERIO:  
   !           THE WELD START POINT IS LESS THAN (2 * NOZZLE_RADIUS) ABOVE THE HURDLE THEN THE WELD SHOULD BE FLIPPED DIRECTIONALLY
 
FOR w FROM 1 TO How_Many
STEP + 1 DO
    
    
IF (LL_CHAN_WELDS{w,1}.trans.Y - (LEFT_Hurdle + (2*NOZZLE_RADIUS)) < (2*NOZZLE_RADIUS)) AND (LL_CHAN_WELDS{w,1}.trans.Y > LEFT_Hurdle) AND (LL_CHAN_WELDS{w,3}.trans.Y > LEFT_Hurdle) AND LL_CHAN_NOTES{ w , 2} <> "BUDGED" AND LL_CHAN_NOTES{ w , 2} <> "FLIPPED"  THEN
    
    Hold_This := LL_CHAN_WELDS{w,1}.trans.Y;
    
    LL_CHAN_WELDS{w,1}.trans.Y := LL_CHAN_WELDS{w,3}.trans.Y  ; 
    LL_CHAN_WELDS{w,3}.trans.Y := Hold_This; 
    
    LL_CHAN_WELDS{w,1}.Rot := LL_CHAN_GOINGDOWN.Rot;  
    LL_CHAN_WELDS{w,2}.Rot := LL_CHAN_GOINGDOWN.Rot;     
    LL_CHAN_WELDS{w,3}.Rot := LL_CHAN_GOINGDOWN.Rot; 

    LL_CHAN_WELDS{w,1}.Extax := LL_CHAN_GOINGDOWN.Extax; 
    LL_CHAN_WELDS{w,2}.Extax := LL_CHAN_GOINGDOWN.Extax; 
    LL_CHAN_WELDS{w,3}.Extax := LL_CHAN_GOINGDOWN.Extax; 
    
    LL_CHAN_WELDS{w,1}.RobConf := LL_CHAN_GOINGDOWN.RobConf;  
    LL_CHAN_WELDS{w,2}.RobConf := LL_CHAN_GOINGDOWN.RobConf;     
    LL_CHAN_WELDS{w,3}.RobConf := LL_CHAN_GOINGDOWN.RobConf; 
    
ENDIF   

! SAME SCENERIO, OPPOSITE SIDE
IF RR_CHAN_WELDS{w,1}.trans.Y - (RIGHT_Hurdle + (2*NOZZLE_RADIUS)) < (2*NOZZLE_RADIUS) AND (RR_CHAN_WELDS{w,1}.trans.Y > RIGHT_Hurdle) AND (RR_CHAN_WELDS{w,3}.trans.Y > RIGHT_Hurdle) AND RR_CHAN_NOTES{ w , 2} <> "BUDGED" AND RR_CHAN_NOTES{ w , 2} <> "FLIPPED" THEN
    
    Hold_This := RR_CHAN_WELDS{w,1}.trans.Y;
    
    RR_CHAN_WELDS{w,1}.trans.Y := RR_CHAN_WELDS{w,3}.trans.Y; 
    RR_CHAN_WELDS{w,3}.trans.Y := Hold_This; 
    
    RR_CHAN_WELDS{w,1}.Rot := RR_CHAN_GOINGDOWN.Rot; 
    RR_CHAN_WELDS{w,2}.Rot := RR_CHAN_GOINGDOWN.Rot; 
    RR_CHAN_WELDS{w,3}.Rot := RR_CHAN_GOINGDOWN.Rot; 
    
    RR_CHAN_WELDS{w,1}.Extax := RR_CHAN_GOINGDOWN.Extax; 
    RR_CHAN_WELDS{w,2}.Extax := RR_CHAN_GOINGDOWN.Extax; 
    RR_CHAN_WELDS{w,3}.Extax := RR_CHAN_GOINGDOWN.Extax; 
    
    RR_CHAN_WELDS{w,1}.RobConf := RR_CHAN_GOINGDOWN.RobConf; 
    RR_CHAN_WELDS{w,2}.RobConf := RR_CHAN_GOINGDOWN.RobConf; 
    RR_CHAN_WELDS{w,3}.RobConf := RR_CHAN_GOINGDOWN.RobConf; 
    
ENDIF   
ENDFOR


!  AFTER THINGS HAVE BEEN SHIFTED, 

    !  IF THE WELD IS INSIDE THE TIGHTBOX THEN SKIP AS MANY WELDS AS NEEDED   !
 
 IF  Y1_TightBox = TRUE OR  Y2_TightBox = TRUE OR Y3_TightBox = TRUE OR Y4_TightBox = TRUE THEN
            FOR Z FROM 1 TO How_Many
            STEP +1 DO  
           
            IF  Y1_TightBox = TRUE AND  (LL_CHAN_WELDS{Z,1}.trans.Y < HORIZ_Y1) THEN
                 LL_CHAN_NOTES{ Z , 1}:= "SKIP";
                 RR_CHAN_NOTES{ Z , 1}:= "SKIP";
            ENDIF 
                
            IF  Y2_TightBox = TRUE AND  (LL_CHAN_WELDS{Z,1}.trans.Y > HORIZ_Y2) THEN
                 LL_CHAN_NOTES{ Z , 1}:= "SKIP";
                 RR_CHAN_NOTES{ Z , 1}:= "SKIP";
            ENDIF    
            
            IF  Y3_TightBox = TRUE AND  (LL_CHAN_WELDS{Z,3}.trans.Y > HORIZ_Y3) THEN
                 LL_CHAN_NOTES{ Z , 1}:= "SKIP";
                 RR_CHAN_NOTES{ Z , 1}:= "SKIP";
            ENDIF
            
            IF  Y4_TightBox = TRUE AND  (LL_CHAN_WELDS{Z,3}.trans.Y > HORIZ_Y4) THEN
                 LL_CHAN_NOTES{ Z , 1}:= "SKIP";
                 RR_CHAN_NOTES{ Z , 1}:= "SKIP";
            ENDIF    
            
          ENDFOR
 ENDIF



NOT_TODAY: 


ENDPROC




PROC LRnRL_CHAN_PLAN (
    STRING THE_OBJECT)
    

!  NOTES
! This is for the INSIDE of the channels
!  R23  ADDED LEFT_Hurdle & RIGHT_Hurdle  4/9/19
    
VAR NUM LEFT_Hurdle := 0;
VAR NUM RIGHT_Hurdle := 0;
VAR NUM Uh_Hurdle := 0;
VAR NUM Hold_This;
VAR NUM WELD_REMAINDER;


        
 IF THE_OBJECT = "Anchor" THEN
     Uh_Hurdle := Anchor_Y;
     
 ELSEIF THE_OBJECT = "Push_Stop" THEN
     Uh_Hurdle := Anchor_Y + ANCHOR_2_PushStop.trans.Y;
     
 ELSEIF THE_OBJECT = "Chan_Bottom" THEN
     Uh_Hurdle := Top_Of_Chan_Y - CHANNEL_LENGTH;
     
 ELSEIF THE_OBJECT = "Y3"  and MY3_Weld_Count > 0 THEN
     Uh_Hurdle := HORIZ_Y3;
     Left_Hurdle := HORIZ_Y3 + SR_LX2_Y3.TRANS.Y;
     Right_Hurdle := HORIZ_Y3 + SR_RX2_Y3.TRANS.Y;
     
 ELSEIF THE_OBJECT = "Y4" and MY4_Weld_Count > 0  THEN
     Uh_Hurdle := HORIZ_Y4; 
     Left_Hurdle := HORIZ_Y4 + SR_LX2_Y4.TRANS.Y;
     Right_Hurdle := HORIZ_Y4 + SR_RX2_Y4.TRANS.Y;
 
 ENDIF
 
 ! NOTES
 !  ADDED  " and MY3_Weld_Count > 0 THEN " TO KEEP THE WELD FROM BEING FLIPPED OVER WHEN THERE IS NO CENTER BAR 6/3/20 SS
 
 
 
 

! test for push_only = true then
!!   test for anchor
!    test for ANCHOR_2_PushStop
!  endif
! test all for channel bottom, if channel_bottom < 1/2 stitch then flip weld sequence from ODD to EVEN
! if y3 <> fp_height then test 50/50 stitch over y3_hurdle

IF LOAD_PUSH = TRUE THEN  
 
 IF THE_OBJECT = "Anchor" THEN 
    
 FOR e FROM 2 TO How_Many
 STEP + 1 DO
 
 IF ((LR_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle )) OR (LR_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle AND LR_CHAN_WELDS{e,3}.Trans.Y > (Uh_Hurdle - 20))  OR  (LR_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle + 45 AND LR_CHAN_WELDS{e,3}.Trans.Y > (Uh_Hurdle + 45)) THEN
! SKIP this weld, it's too tight
        LR_CHAN_NOTES{e,1} := "SKIP";
ENDIF

 IF ((RL_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle )) OR (RL_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle AND RL_CHAN_WELDS{e,3}.Trans.Y > (Uh_Hurdle - 20))  OR  (RL_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle + 45 AND RL_CHAN_WELDS{e,3}.Trans.Y > (Uh_Hurdle + 45)) THEN
! SKIP this weld, it's too tight
RL_CHAN_NOTES{e,1} := "SKIP";


! WAS ...
!     IF ((RL_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle AND RL_CHAN_WELDS{e,3}.Trans.Y > Uh_Hurdle)) OR (RL_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle AND RL_CHAN_WELDS{e,3}.Trans.Y > (Uh_Hurdle - 20))  OR  (RL_CHAN_WELDS{e,1}.Trans.Y < Uh_Hurdle + 45 AND RL_CHAN_WELDS{e,3}.Trans.Y > (Uh_Hurdle + 45)) THEN
! UpDated 7/22/21/SS skipping all weld below the anchor on LRnRL, just to satisify the need of having a channel 6898779 on a Friday when I'm not here and Dan W. will just walk away.

ENDIF
ENDFOR    
ENDIF   


IF THE_OBJECT = "Push_Stop" THEN
 FOR p FROM 2 TO How_Many
 STEP + 1 DO 

  ! this test is for the LR_Chan weld overlapping with the Load_Push bump stop
  ! there are conditions:
  ! for starting below the round and overlapping into it, THEN trim it 
  ! for being more than half way in to it, THEN skip
  ! 
  ! for starting over half way thru the ROUND, THEN flip the path and tie it in.
  ! for being closer that (2*NOZZLE_RAD) from it,  THEN just flip the path.
  
  IF ABS(RL_CHAN_WELDS{p,3}.trans.Y - Uh_Hurdle ) <= NOZZLE_RADIUS AND RL_CHAN_WELDS{p,3}.trans.Y >= (Uh_Hurdle - NOZZLE_RADIUS) AND Abs(RL_CHAN_WELDS{p,1}.trans.Y - Uh_Hurdle)  >= (How_Long/2) THEN
    ! This test if the weld end is closer than 1*NOZZLE_RADIUS from the bottom, THEN TIE IT IN
    RL_CHAN_WELDS{p,1}.Trans.Y := RL_CHAN_WELDS{p,1}.Trans.Y;
    RL_CHAN_WELDS{p,1}.extax := RL_CHAN_GOINGup.extax;
    RL_CHAN_WELDS{p,1}.ROT := RL_CHAN_GOINGup.ROT;
    RL_CHAN_WELDS{p,1}.RobConf := RL_CHAN_GOINGup.RobConf;
    
    RL_CHAN_WELDS{p,2}.Trans.Y := (Uh_Hurdle - NOZZLE_RADIUS);
    RL_CHAN_WELDS{p,2}.extax := RL_CHAN_GOINGup.extax;
    RL_CHAN_WELDS{p,2}.ROT := RL_CHAN_GOINGup.ROT;
    RL_CHAN_WELDS{p,2}.RobConf := RL_CHAN_GOINGup.RobConf;
    
    RL_CHAN_WELDS{p,3}.Trans.Y := (Uh_Hurdle - FP_StickOut);
    RL_CHAN_WELDS{p,3}.extax := RL_Chan_goingUPcorner.extax;
    RL_CHAN_WELDS{p,3}.ROT := RL_CHAN_GOINGupCORNER.ROT;
    RL_CHAN_WELDS{p,3}.RobConf := RL_CHAN_GOINGupCORNER.RobConf;
    RL_CHAN_NOTES{p,1} := "CORNER";
  
  ELSEIF ABS( RL_CHAN_WELDS{p,1}.Trans.Y - Uh_Hurdle) <= (How_Long/2) AND (RL_CHAN_WELDS{p,1}.TRANS.Y <= Uh_Hurdle) AND (RL_CHAN_WELDS{p,3}.TRANS.Y > Uh_Hurdle) THEN
    ! IF THE WELD IS MORE THAN HALF WAY INTO THE ROUND, FROM THE BOTTOM SIDE, SKIP IT
    RL_CHAN_NOTES{p,1} := "SKIP";
    WaitTime\InPos,.05;
   
  ELSEIF ABS(RL_CHAN_WELDS{p,1}.Trans.Y - (Uh_Hurdle + (2*PUSH_RND_RADIUS))) <= (How_Long/2) AND RL_CHAN_WELDS{p,1}.TRANS.Y <= (Uh_Hurdle + (2*PUSH_RND_RADIUS)) AND RL_CHAN_WELDS{p,3}.TRANS.Y >= (Uh_Hurdle + (2*PUSH_RND_RADIUS)) THEN
    ! IF THE WELD IS MORE THAN HALF WAY INTO THE ROUND, FROM THE TOP SIDE, SKIP IT; CHANGED TO LESS THAN 10/19/20/SS 6894640 WAS CRASHING ON PUSHSTOP
    RL_CHAN_NOTES{p,1} := "SKIP";        
    WaitTime\InPos,.05;
  
  ELSEIF ABS(RL_CHAN_WELDS{p,1}.trans.Y - (Uh_Hurdle + (2*PUSH_RND_RADIUS))) <= (NOZZLE_RADIUS) AND (RL_CHAN_WELDS{p,1}.trans.Y >= (Uh_Hurdle + (PUSH_RND_RADIUS))) AND (RL_CHAN_WELDS{p,3}.trans.Y >= (Uh_Hurdle + (2*PUSH_RND_RADIUS))) THEN
    ! IF THE WELD START IS LESS THAN A NOZZLE_RADIUS FROM THE TOP OF THE ROUND, THEN FLIP THE PATH AND TIE IT IN TO THE TO TOP OF THE ROUND
    Hold_This := RL_CHAN_WELDS{p,1}.Trans.Y;
    RL_CHAN_WELDS{p,1}.Trans.Y := RL_CHAN_WELDS{p,3}.Trans.Y;
    RL_CHAN_WELDS{p,1}.extax := RL_CHAN_GOINGDOWN.extax;
    RL_CHAN_WELDS{p,1}.ROT := RL_CHAN_GOINGDOWN.ROT;
    RL_CHAN_WELDS{p,1}.RobConf := RL_CHAN_GOINGDOWN.RobConf;
    
    RL_CHAN_WELDS{p,2}.Trans.Y := Hold_This + NOZZLE_RADIUS;
    RL_CHAN_WELDS{p,2}.extax := RL_CHAN_GOINGDOWN.extax;
    RL_CHAN_WELDS{p,2}.ROT := RL_CHAN_GOINGDOWN.ROT;
    RL_CHAN_WELDS{p,2}.RobConf := RL_CHAN_GOINGDOWN.RobConf;
    
    RL_CHAN_WELDS{p,3}.Trans.Y := Uh_Hurdle + (2* PUSH_RND_RADIUS) + FP_StickOut;
    RL_CHAN_WELDS{p,3}.extax := RL_Chan_BOTTOMcorner.extax;
    RL_CHAN_WELDS{p,3}.ROT := RL_Chan_BOTTOMcorner.ROT;
    RL_CHAN_WELDS{p,3}.RobConf := RL_Chan_BOTTOMcorner.RobConf;
    RL_CHAN_NOTES{p,1} := "CORNER";    
    
  ELSEIF ABS(RL_CHAN_WELDS{p,1}.trans.Y - (Uh_Hurdle + (2*PUSH_RND_RADIUS))) <= (2*NOZZLE_RADIUS) AND (RL_CHAN_WELDS{p,1}.trans.Y >= (Uh_Hurdle + (2*PUSH_RND_RADIUS))) AND (RL_CHAN_WELDS{p,3}.trans.Y >= (Uh_Hurdle + (2*PUSH_RND_RADIUS))) THEN
    ! IF THE WELD START IS LESS THAN (2*NOZZLE_RADIUS) ABOVE THE ROUND, THEN JUST FLIP THE PATH
