	PROC yTIP_WOBJ_DOCTOR(INOUT wobjdata wobjHtip,num WTIPANGLE)
        !!!!!!Created to adjust tip wobj by a search result!!!!!
        !!!!!! R-0 01-11-16 sy !!!!!!!!!!!!!!!
        !!!!!! R-1 01-20-16  sy !!!!!!!!!!!!!!!

        IF ADJTIPSRCH > 0 THEN
        	WTIPANGLEadj := WTIPANGLE - Abs(ADJTIPSRCH);
        ELSE
        	WTIPANGLEadj := WTIPANGLE + Abs(ADJTIPSRCH);
        ENDIF

		nZ := 0;
		nY := 0;
		nX := WTIPANGLEadj;
        wobjHtip := obSTN1;
        FRAME_TIP.rot := OrientZYX(nZ,nY,nX);
		FRAME_TIP.trans.x := 0 + FRAME_BASE.trans.x;
		FRAME_TIP.trans.y := -14 + FRAME_BASE.trans.y;
		FRAME_TIP.trans.z := 204.5 + FRAME_BASE.trans.z;
		wobjHtip.oframe := FRAME_TIP;
        WaitTime 0.5;
        TPWrite "ORIGINAL WTIPANGLE IS :="\num := WTIPANGLE;        
        TPWrite ".............";  
        TPWrite "WTIPANGLE ADJUSTED IS :="\num := WTIPANGLEadj;  
        WaitTime 2; 
 
    ENDPROC

